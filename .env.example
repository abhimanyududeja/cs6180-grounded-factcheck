# Copy to .env and fill in. .env is gitignored.
#
# Get a key at https://platform.openai.com/api-keys
# Budget: the whole project (index build + full evaluation + a demo) runs
# comfortably under $5 with the defaults in config.yaml.
OPENAI_API_KEY=sk-...

# Your own email. It goes in the User-Agent so the federal sites we download
# from can identify the client. Required before the first download.
FOGA_CONTACT_EMAIL=you@university.edu

# Optional. Only needed if you switch config.yaml to llm.provider: ollama
# OLLAMA_HOST=http://localhost:11434
