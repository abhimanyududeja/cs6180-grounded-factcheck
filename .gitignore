.venv/
__pycache__/
*.pyc

# Corpus, cache and index: large, and rebuilt by `make download && make index`.
data/
# Raw evaluation dumps. The summary tables live in REPORT.md and RESULTS.md.
# Raw evaluation output. The runs the report cites are committed, since the app's
# evaluation view reads them and every figure should be traceable to its source
# file. Intermediate and superseded runs are not.
reports/*.json
!reports/*v3_*.json
!reports/*oai_*.json

# Never commit credentials or the contact address.
.env
.env.*
!.env.example

# Generated from the .md files by pandoc; regenerate rather than diff binaries.
*.docx
*.pptx

# Presentation notes: ours, not for the public repo.
DEMO_SCRIPT.md
